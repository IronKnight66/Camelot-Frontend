# Environment Configuration for Camelot Frontend
# These values are used during Docker build (React requires build-time env vars)
# For production builds, these should be passed from Terraform outputs as Docker build arguments

# AWS Configuration
REACT_APP_AWS_REGION=us-east-1

# Cognito Configuration
# Get from Terraform output: terraform output -raw cognito_user_pool_id
REACT_APP_COGNITO_USER_POOL_ID=

# Get from Terraform output: terraform output -raw cognito_client_id
REACT_APP_COGNITO_CLIENT_ID=

# Get from Terraform output: terraform output -raw cognito_domain
REACT_APP_COGNITO_DOMAIN=

# API Configuration
# Get from Terraform output: terraform output -raw api_gateway_endpoint
REACT_APP_API_URL=

# Redirect URLs
# For production: https://<frontend_domain>/
REACT_APP_REDIRECT_SIGN_IN=http://localhost:3000/
REACT_APP_REDIRECT_SIGN_OUT=http://localhost:3000/

# For local development, create a .env file with these values.
# For production deployments, the CI/CD pipeline automatically:
#   1. Gets Terraform outputs after infrastructure deployment
#   2. Builds Docker image with these values
#   3. Pushes to ECR
#   4. Updates ECS service to use new image
#
# No manual build script needed - everything is automated via Git tags!
